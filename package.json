{
  "name": "colloion",
  "private": true,
  "version": "0.3.2",
  "description": "コロイド・イオン溶液の電解調製を記録／計算するツール（趣味実験用）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomu-ai963/colloion.git"
  },
  "homepage": "https://colloion.tomu-ai.dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint src worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:worker": "npm run build && wrangler dev",
    "migrate:local": "wrangler d1 migrations apply colloion --local"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^5.4.20",
    "vitest": "^2.1.9",
    "wrangler": "^4.150.0"
  }
}
