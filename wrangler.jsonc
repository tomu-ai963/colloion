// colloion Worker（Phase 3）: フロント（dist/）の配信と同期 API（/api/*）を同じオリジンで提供する。
// deploy は `npm run build && npx wrangler deploy`（とむの確認を取ってから）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colloion",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // 入口はカスタムドメイン 1 つに絞る。workers.dev / Preview URL があると別オリジンの入口になり、
  // Cookie が別オリジンに付く・Neon Auth の trusted origins に無いなどでログインが壊れる
  // （書かないと deploy のたびに既定で有効化される。bitane の wrangler.jsonc の注記を参照）
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "colloion.tomu-ai.dev", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false }
  },
  // vite build の出力（npm run build）。/api/* だけ Worker を先に通す
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // **NEON_AUTH_BASE_URL はここに書かない。** 本番は `wrangler secret put`、ローカルは .dev.vars。
    // 中継（/api/auth/*）しているのでブラウザには見えない値で、公開リポジトリに載せると
    // Neon の認証 API を直接叩ける入口を晒す。また secret と同名のキーが vars にあると
    // secret の継承が阻害され、空の値が本番に載る（bitane の wrangler.jsonc の注記を参照）
    //
    // 本番は同一オリジンなので空。vite の開発サーバーは /api を wrangler dev へ中継する（vite.config.ts）
    "ALLOWED_ORIGINS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "colloion",
      // 本番 D1（2026-10-13 `wrangler d1 create colloion --location apac`）。
      // migrations の --remote 適用はとむが行う
      "database_id": "44feb36a-c971-4c5a-ab27-eafb3a23c770",
      "migrations_dir": "migrations"
    }
  ]
}
