// colloion Worker（Phase 3）: フロント（dist/）の配信と同期 API（/api/*）を同じオリジンで提供する。
// 本番のリソース作成（d1 create）・カスタムドメイン設定・deploy は、とむの確認を取ってから行う。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colloion",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false }
  },
  // vite build --base / の出力（npm run build:worker）。/api/* だけ Worker を先に通す
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // **NEON_AUTH_BASE_URL はここに書かない。** 本番は `wrangler secret put`、ローカルは .dev.vars。
    // 中継（/api/auth/*）しているのでブラウザには見えない値で、公開リポジトリに載せると
    // Neon の認証 API を直接叩ける入口を晒す。また secret と同名のキーが vars にあると
    // secret の継承が阻害され、空の値が本番に載る（bitane の wrangler.jsonc の注記を参照）
    //
    // 本番は同一オリジンなので空。vite の開発サーバーは /api を wrangler dev へ中継する（vite.config.ts）
    "ALLOWED_ORIGINS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "colloion",
      // ローカル（--local）専用の仮 ID。本番は `wrangler d1 create colloion` の出力に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
